ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-strong-password
ADMIN_SECRET=your-long-random-secret

# Form Configuration
FORM_RATE_LIMIT=5
FORM_RATE_LIMIT_WINDOW=60000

# Form settings
NEXT_PUBLIC_FORM_ACTION_URL=/api/contact
FORM_SPAM_SCORE_THRESHOLD=0.5

# Analytics (does not track personal data)
NEXT_PUBLIC_ANALYTICS_ENABLED=true
